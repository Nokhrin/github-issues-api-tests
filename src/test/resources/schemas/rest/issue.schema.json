{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitHub Issue",
  "type": "object",
  "required": [
    "id",
    "number",
    "title",
    "state"
  ],
  "properties": {
    "id": {
      "type": "integer"
    },
    "number": {
      "type": "integer"
    },
    "title": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ]
    }
  }
}
