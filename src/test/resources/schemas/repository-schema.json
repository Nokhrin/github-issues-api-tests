{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitHub Repository",
  "type": "object",
  "required": [
    "name",
    "full_name",
    "owner"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "full_name": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "object",
      "required": [
        "login"
      ],
      "properties": {
        "login": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
